{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "prettier . --write",
    "lint": "eslint --fix --ext .js,.vue .",
    "lint:check": "eslint --ext .js,.vue .",
    "prepare": "husky",
    "upload:images": "node -r dotenv/config upload-to-cloudinary.js",
    "optimise:images": "find public/images \\( -iname \"*.jpg\" -o -iname \"*.png\" \\) -exec sh -c 'magick \"$1\" -resize 1920x1920\\> -quality 80 -strip \"${1%.*}.webp\" && rm \"$1\"' _ {} \\;",
    "optimise:images:hero": "find public/images \\( -iname \"*.jpg\" -o -iname \"*.png\" \\) -exec sh -c 'magick \"$1\" -resize 2560x1440\\> -quality 90 -strip \"${1%.*}.webp\" && rm \"$1\"' _ {} \\;"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@lottiefiles/dotlottie-vue": "^0.10.10",
    "@nuxt/image": "^1.5.0",
    "@nuxtjs/tailwindcss": "^6.12.0",
    "@pinia/nuxt": "^0.11.0",
    "@tailwindcss/vite": "^4.0.12",
    "caniuse-lite": "^1.0.30001692",
    "cloudinary": "^2.8.0",
    "nuxt": "^3.16.0",
    "pinia": "^3.0.2",
    "stylelint-config-recommended-vue": "^1.5.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@vue/compiler-sfc": "^3.5.13",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.5",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sass": "^1.77.4",
    "stylelint": "^16.3.0",
    "stylelint-config-recommended": "^14.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.7.3"
  }
}
